#!/bin/sh
# ode-install - installs itelxOS from the ODE installation medium.
#
# The ODE installer is the original one (IFelxOS2-amd64.iso, the same
# kernel, installer system and window); this backend replaces its
# /usr/sbin/ode-install so that it installs itelxOS instead of IFelxOS2. It
# keeps the original's command line and output, which the window speaks:
#
#   ode-install check erase  <disk>
#   ode-install check manual <disk> <partition>
#       OK, WARN <message> or FAIL <message> lines; exit status 1 on FAIL
#   ode-install erase  <disk> <computer-name> <account>
#   ode-install manual <disk> <partition> <computer-name> <account>
#       installs; the window sends a password on standard input. itelxOS 1.2
#       has no sign-in, so the password is read and dropped; the account
#       name is kept as the owner's name in /system/owner
#   output: STEP <name> <percent> | PROGRESS <percent> | WARN | ERROR | DONE
#
# The medium's ifelxos/filesystem.squashfs holds the itelxOS installation
# tree (made by itelxOS64bit, "make installer"):
#   rootfs/   the itelx system: /kernel /boot /system /dex /ram /usb
#   esp/      IFelxBoot (EFI/BOOT/BOOTX64.EFI), \boot\vmlinuz (the itelx
#             kernel), \boot\initrd.img (the boot bundle)
#   bios/     itelx's BIOS boot code: mbr.bin, stage2.bin
#   tools/    itfs (writes ITFS) and itelx-installboot, static programs
#
# erase  a new MBR table: EFI system partition (256 MiB, FAT32, 0xEF, active)
#        and the itelx partition (ITFS, 0x7F). Starts on UEFI (IFelxBoot) and
#        BIOS (itelx MBR + stage2, no GRUB).
# manual one chosen partition becomes ITFS; the others are kept; an EFI
#        system partition on the disk is used, not formatted.

set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

MEDIUM=/run/ode/medium
IMAGE=$MEDIUM/ifelxos/filesystem.squashfs
SRC=/run/ode/itelx
ESPDIR=/run/ode/esp
SYSNAME=itelxOS
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
MIN_ROOT_MIB=${ODE_MIN_ROOT_MIB:-256}
ESP_MIB=256
ESP_NEED_KIB=$((8 * 1024))

say()  { echo "$*"; }
warn() { echo "WARN $*"; }
step() { echo "STEP $1 $2"; }
cleanup() { umount "$ESPDIR" 2>/dev/null; }
die() { echo "ERROR $*"; cleanup; exit 1; }

# ---------------------------------------------------------------- helpers

uefi_boot() { [ -d /sys/firmware/efi ]; }

part_path() {
    case "$1" in
        *[0-9]) echo "${1}p$2" ;;
        *) echo "$1$2" ;;
    esac
}

disk_parts() {
    b=${1##*/}
    for s in /sys/class/block/"$b"/"$b"*; do
        [ -f "$s/partition" ] && echo "/dev/${s##*/}"
    done
}

part_number() { cat "/sys/class/block/${1##*/}/partition" 2>/dev/null; }

size_mib() {
    s=$(cat "/sys/class/block/${1##*/}/size" 2>/dev/null) || s=0
    echo $((s / 2048))
}

probe() { blkid -p -o value -s "$2" "$1" 2>/dev/null | head -n 1; }
parttype() { probe "$1" PART_ENTRY_TYPE | tr 'A-Z' 'a-z'; }

is_esp() {
    case "$(parttype "$1")" in "$ESP_GUID"|0xef) return 0 ;; esac
    return 1
}

find_esp() {
    for p in $(disk_parts "$1"); do
        is_esp "$p" && { echo "$p"; return 0; }
    done
    return 1
}

medium_disk() {
    dev=$(cat /run/ode/medium.dev 2>/dev/null)
    [ -n "$dev" ] || dev=$(awk -v m="$MEDIUM" '$2 == m {print $1}' /proc/mounts | head -n 1)
    [ -n "$dev" ] || return 1
    b=${dev##*/}
    if [ -f "/sys/class/block/$b/partition" ]; then
        b=$(basename "$(dirname "$(readlink -f "/sys/class/block/$b")")")
    fi
    echo "/dev/$b"
}

on_disk() {
    case "$1" in
        "$2"|"$2"[0-9]*|"$2"p[0-9]*) return 0 ;;
    esac
    return 1
}

release_disk() {
    awk '{print $1}' /proc/swaps | while read -r d; do
        on_disk "$d" "$1" && swapoff "$d" 2>/dev/null
    done
    awk '{print $1, $2}' /proc/mounts | sort -r -k2 | while read -r d m; do
        on_disk "$d" "$1" && umount "$m" 2>/dev/null
    done
    for d in $(awk '{print $1}' /proc/mounts); do
        on_disk "$d" "$1" && return 1
    done
    return 0
}

valid_disk() {
    [ -b "$1" ] || { echo "FAIL $1 is not a disk"; return 1; }
    [ -f "/sys/class/block/${1##*/}/partition" ] && { echo "FAIL $1 is a partition, not a disk"; return 1; }
    md=$(medium_disk)
    [ -n "$md" ] && [ "$md" = "$1" ] && { echo "FAIL $1 holds the installation medium"; return 1; }
    return 0
}

# the type byte of a primary MBR partition (parted cannot set 0x7F)
set_mbr_type() {
    python3 - "$1" "$2" "$3" <<'EOF'
import sys
disk, num, typ = sys.argv[1], int(sys.argv[2]), int(sys.argv[3], 16)
with open(disk, "r+b") as f:
    mbr = bytearray(f.read(512))
    if mbr[510:512] != b"\x55\xaa" or not 1 <= num <= 4:
        sys.exit(1)
    mbr[0x1BE + (num - 1) * 16 + 4] = typ
    f.seek(0)
    f.write(mbr)
EOF
}

# ------------------------------------------------------------------ checks

check_image() {
    [ -f "$IMAGE" ] || { echo "FAIL the $SYSNAME image was not found on the installation medium"; return 1; }
    return 0
}

check_erase() {
    disk=$1; ok=0
    valid_disk "$disk" || return 1
    need=$((MIN_ROOT_MIB + ESP_MIB + 2))
    have=$(size_mib "$disk")
    if [ "$have" -lt "$need" ]; then
        echo "FAIL $disk is too small: $SYSNAME needs at least $need MiB"
        ok=1
    fi
    [ "$have" -gt $((2 * 1024 * 1024)) ] &&
        echo "WARN only the first 2 TiB of $disk will be used (MBR partition table)"
    check_image || ok=1
    [ $ok = 0 ] && echo "OK"
    return $ok
}

check_manual() {
    disk=$1; root=$2; ok=0
    valid_disk "$disk" || return 1
    [ -b "$root" ] || { echo "FAIL $root does not exist"; return 1; }
    [ "$(dirname "$(readlink -f "/sys/class/block/${root##*/}")")" = \
      "$(readlink -f "/sys/class/block/${disk##*/}")" ] ||
        { echo "FAIL $root is not on $disk"; return 1; }
    check_image || ok=1
    case "$(parttype "$root")" in
        "$ESP_GUID"|0xef) echo "FAIL $root is the EFI system partition; choose another partition"; return 1 ;;
        0x5|0xf|0x85) echo "FAIL $root is an extended partition; choose a partition inside it"; return 1 ;;
    esac
    if [ "$(size_mib "$root")" -lt "$MIN_ROOT_MIB" ]; then
        echo "FAIL $root is too small: $SYSNAME needs at least $MIN_ROOT_MIB MiB"
        ok=1
    fi
    pttype=$(probe "$disk" PTTYPE)
    esp=$(find_esp "$disk")
    if [ -n "$esp" ]; then
        case "$(probe "$esp" TYPE)" in
            vfat)
                mkdir -p "$ESPDIR"
                if mount -t vfat -o ro "$esp" "$ESPDIR" 2>/dev/null; then
                    free=$(df -Pk "$ESPDIR" | awk 'NR==2 {print $4}')
                    umount "$ESPDIR"
                    if [ "${free:-0}" -lt "$ESP_NEED_KIB" ]; then
                        echo "FAIL the EFI partition $esp has too little free space ($SYSNAME needs 8 MiB there)"
                        ok=1
                    else
                        echo "WARN the EFI partition $esp is kept as it is; $SYSNAME is added to it"
                    fi
                else
                    echo "FAIL the EFI partition $esp could not be read"; ok=1
                fi ;;
            "") echo "WARN the empty EFI partition $esp will be formatted (FAT32)" ;;
            *)  echo "FAIL the EFI partition $esp holds $(probe "$esp" TYPE), not FAT"; ok=1 ;;
        esac
    else
        echo "FAIL $disk has no EFI system partition; itelx keeps its kernel there (UEFI and BIOS start). Create one in GParted (FAT32, 300 MiB, flag esp) or choose Erase disk"
        ok=1
    fi
    if [ "$pttype" = gpt ]; then
        if uefi_boot; then
            echo "WARN $disk uses GPT: it will start through UEFI only (itelx's BIOS start needs an MBR disk)"
        else
            echo "FAIL this computer starts in BIOS mode and $disk uses GPT; itelx's BIOS start needs an MBR (msdos) partition table. Choose Erase disk"
            ok=1
        fi
    elif [ "$pttype" = dos ]; then
        echo "WARN the disk's BIOS start code (MBR) is replaced by itelx's"
    fi
    fstype=$(probe "$root" TYPE)
    [ -n "$fstype" ] && echo "WARN $root holds data ($fstype): everything on it will be erased"
    [ $ok = 0 ] && echo "OK"
    return $ok
}

# ------------------------------------------------------------- installing

wait_for() {
    i=0
    while [ $i -lt 100 ]; do
        ok=1
        for d in "$@"; do [ -b "$d" ] || ok=0; done
        [ $ok = 1 ] && return 0
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

unpack() {
    step unpack 2
    say "reading the $SYSNAME image from the medium"
    rm -rf "$SRC"
    unsquashfs -no-progress -d "$SRC" "$IMAGE" >/dev/null 2>&1 || die "the $SYSNAME image on the medium cannot be read"
    for f in rootfs/kernel/itelx.elf rootfs/system/init.xvr esp/EFI/BOOT/BOOTX64.EFI esp/boot/vmlinuz \
             esp/boot/initrd.img bios/mbr.bin bios/stage2.bin tools/itfs tools/itelx-installboot; do
        [ -s "$SRC/$f" ] || die "the medium does not hold an $SYSNAME image ($f is missing)"
    done
    chmod 755 "$SRC/tools/itfs" "$SRC/tools/itelx-installboot"
    say "$(head -n 1 "$SRC/manifest" 2>/dev/null)"
}

partition_erase() {
    disk=$1
    step partition 8
    release_disk "$disk" || die "a partition of $disk is in use and could not be unmounted"
    say "writing a new partition table on $disk"
    for p in $(disk_parts "$disk"); do wipefs -a -q "$p" 2>/dev/null; done
    wipefs -a -q "$disk" 2>/dev/null
    total=$(size_mib "$disk")
    end=$((total - 1))
    max=$((2 * 1024 * 1024 - 1))
    [ "$end" -gt "$max" ] && end=$max
    parted -s -a optimal "$disk" -- \
        mklabel msdos \
        mkpart primary fat32 1MiB $((1 + ESP_MIB))MiB \
        mkpart primary $((1 + ESP_MIB))MiB "${end}MiB" \
        set 1 esp on \
        set 1 boot on >/dev/null 2>&1 || die "could not write the partition table on $disk"
    set_mbr_type "$disk" 2 7f || die "could not mark the itelx partition (type 0x7F)"
    partprobe "$disk" 2>/dev/null
    udevadm settle --timeout=15 2>/dev/null
    ESP=$(part_path "$disk" 1)
    ROOT=$(part_path "$disk" 2)
    wait_for "$ESP" "$ROOT" || die "the new partitions of $disk did not appear"
    for p in "$ESP" "$ROOT"; do wipefs -a -q "$p" 2>/dev/null; done
    ESP_NEW=1
}

partition_manual() {
    disk=$1
    step partition 8
    release_disk "$disk" || die "a partition of $disk is in use and could not be unmounted"
    ESP=$(find_esp "$disk")
    ESP_NEW=0
    [ -n "$ESP" ] && [ -z "$(probe "$ESP" TYPE)" ] && ESP_NEW=2
    num=$(part_number "$ROOT")
    # an MBR primary partition gets the itelx type; on GPT, or for a logical
    # partition, the kernel finds ITFS by its identity (root=itfs:<uuid>)
    if [ "$(probe "$disk" PTTYPE)" = dos ] && [ "${num:-0}" -le 4 ]; then
        set_mbr_type "$disk" "$num" 7f || warn "could not set the type of $ROOT to 0x7F"
        partprobe "$disk" 2>/dev/null
        udevadm settle --timeout=15 2>/dev/null
        wait_for "$ROOT" || die "$ROOT disappeared"
    fi
    wipefs -a -q "$ROOT" 2>/dev/null
}

make_itfs() {
    step format 15
    say "creating ITFS on $ROOT and copying $SYSNAME into it"
    printf '%s\n' "$HOSTNAME_NEW" > "$SRC/rootfs/system/hostname"
    printf '%s\n' "$ACCOUNT" > "$SRC/rootfs/system/owner"
    UUID=$("$SRC/tools/itfs" mkfs -L itelx -p "$SRC/rootfs" "$ROOT" 2>/tmp/itfs.log | tail -n 1)
    sed 's/^/itfs: /' /tmp/itfs.log
    case "$UUID" in
        ????????????????????????????????) ;;
        *) die "could not create the ITFS filesystem on $ROOT" ;;
    esac
    echo "PROGRESS 60"
    say "ITFS identity: $UUID"
    printf 'root=itfs:%s\n' "$UUID" > "$SRC/cmdline"
    "$SRC/tools/itfs" put "$ROOT" "$SRC/cmdline" /boot/cmdline >/dev/null 2>&1 ||
        die "could not write the command line into $ROOT"
    echo "PROGRESS 70"
}

install_esp() {
    step efi 72
    case "$ESP_NEW" in
        1) mkfs.vfat -F 32 -n ITELX-ESP "$ESP" >/dev/null 2>&1 || die "could not format the EFI partition $ESP" ;;
        2) mkfs.vfat -F 32 -n EFI "$ESP" >/dev/null 2>&1 || die "could not format the EFI partition $ESP" ;;
    esac
    mkdir -p "$ESPDIR"
    umount "$ESPDIR" 2>/dev/null
    mount -t vfat "$ESP" "$ESPDIR" 2>/dev/null || die "could not mount the EFI partition $ESP"
    mkdir -p "$ESPDIR/EFI/BOOT" "$ESPDIR/EFI/$SYSNAME" "$ESPDIR/boot"
    # IFelxBoot reads \boot\vmlinuz, \boot\initrd.img and \boot\cmdline from
    # the partition it was started from
    cp "$SRC/esp/EFI/BOOT/BOOTX64.EFI" "$ESPDIR/EFI/$SYSNAME/BOOTX64.EFI" || die "could not write IFelxBoot"
    if [ "$ESP_NEW" != 0 ] || [ ! -f "$ESPDIR/EFI/BOOT/BOOTX64.EFI" ]; then
        cp "$SRC/esp/EFI/BOOT/BOOTX64.EFI" "$ESPDIR/EFI/BOOT/BOOTX64.EFI"
    fi
    if [ -f "$ESPDIR/boot/vmlinuz" ] && [ "$ESP_NEW" = 0 ]; then
        warn "the EFI partition already had \\boot\\vmlinuz (another IFelx system); it is replaced by $SYSNAME"
    fi
    cp "$SRC/esp/boot/vmlinuz" "$ESPDIR/boot/vmlinuz" &&
    cp "$SRC/esp/boot/initrd.img" "$ESPDIR/boot/initrd.img" &&
    cp "$SRC/cmdline" "$ESPDIR/boot/cmdline" || die "could not write the kernel to the EFI partition"
    sync
    cmp -s "$SRC/esp/boot/vmlinuz" "$ESPDIR/boot/vmlinuz" || die "the kernel on the EFI partition does not match"
    umount "$ESPDIR"
    echo "PROGRESS 80"
}

install_bios() {
    step bootloader 82
    if [ "$(probe "$DISK" PTTYPE)" = gpt ]; then
        say "GPT disk: BIOS start is not set up (UEFI only)"
        return 0
    fi
    "$SRC/tools/itelx-installboot" "$DISK" "$SRC/bios/mbr.bin" "$SRC/bios/stage2.bin" 2>&1 | sed 's/^/installboot: /'
    if "$SRC/tools/itelx-installboot" --verify "$DISK" "$SRC/bios/mbr.bin" "$SRC/bios/stage2.bin" >/dev/null 2>&1; then
        say "BIOS start set up (itelx MBR and stage2)"
    elif uefi_boot; then
        warn "the BIOS start code could not be written; the disk starts through UEFI only"
    else
        die "the BIOS start code could not be written to $DISK"
    fi
}

install_entry() {
    step finish 92
    if uefi_boot && command -v efibootmgr >/dev/null 2>&1; then
        mkdir -p /sys/firmware/efi/efivars
        grep -qs efivarfs /proc/mounts || mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null
        for b in $(efibootmgr 2>/dev/null | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} $SYSNAME\b.*/\1/p"); do
            efibootmgr -q -b "$b" -B >/dev/null 2>&1
        done
        if efibootmgr -q -c -d "$DISK" -p "$(part_number "$ESP")" -L "$SYSNAME" \
               -l "\\EFI\\$SYSNAME\\BOOTX64.EFI" >/dev/null 2>&1; then
            say "UEFI boot entry $SYSNAME added"
        else
            say "the firmware refused a boot entry; it starts the disk through its fallback path"
        fi
    fi
    if "$SRC/tools/itfs" check "$ROOT" >/tmp/itfs-check.log 2>&1; then
        say "ITFS check: clean"
    else
        sed 's/^/itfs: /' /tmp/itfs-check.log
        die "the new ITFS filesystem did not pass its check"
    fi
}

# ------------------------------------------------------------------- main

case "${1:-}" in
    check)
        case "${2:-}" in
            erase)  [ $# -eq 3 ] || { echo "FAIL usage"; exit 1; }; check_erase "$3"; exit $? ;;
            manual) [ $# -eq 4 ] || { echo "FAIL usage"; exit 1; }; check_manual "$3" "$4"; exit $? ;;
        esac
        echo "FAIL usage"; exit 1 ;;
    erase)
        [ $# -eq 4 ] || die "usage: ode-install erase <disk> <computer-name> <account>"
        MODE=erase; DISK=$2; ROOT=""; HOSTNAME_NEW=$3; ACCOUNT=$4 ;;
    manual)
        [ $# -eq 5 ] || die "usage: ode-install manual <disk> <partition> <computer-name> <account>"
        MODE=manual; DISK=$2; ROOT=$3; HOSTNAME_NEW=$4; ACCOUNT=$5 ;;
    *)
        echo "usage: ode-install check erase|manual ... | erase ... | manual ..." >&2; exit 2 ;;
esac

# the window's password line: itelxOS 1.2 has no sign-in, so it is dropped
IFS= read -r _password || true
_password=""

case "$HOSTNAME_NEW" in
    ''|-*|*-|*[!A-Za-z0-9-]*) die "the computer name may only hold letters, digits and '-'" ;;
esac
[ ${#HOSTNAME_NEW} -le 63 ] || die "the computer name is longer than 63 characters"
case "$ACCOUNT" in
    *[!a-z0-9_-]*) die "the account name may only hold a-z, 0-9, '_' and '-'" ;;
esac

if [ "$MODE" = erase ]; then
    check_erase "$DISK" > /tmp/ode-check.$$ || { m=$(grep '^FAIL' /tmp/ode-check.$$ | head -n 1); rm -f /tmp/ode-check.$$; die "${m#FAIL }"; }
else
    check_manual "$DISK" "$ROOT" > /tmp/ode-check.$$ || { m=$(grep '^FAIL' /tmp/ode-check.$$ | head -n 1); rm -f /tmp/ode-check.$$; die "${m#FAIL }"; }
fi
rm -f /tmp/ode-check.$$

say "installing $SYSNAME on $DISK ($MODE)"
unpack
if [ "$MODE" = erase ]; then partition_erase "$DISK"; else partition_manual "$DISK"; fi
[ -n "$ESP" ] || die "there is no EFI system partition to put the kernel on"
make_itfs
install_esp
install_bios
install_entry
step finish 99
cleanup
sync
rm -rf "$SRC"
say "installation complete"
echo "DONE"
